# Azure Certificate Lifecycle Management Configuration
# Copy this file to .env and update the values

# Required: Azure Subscription and Resource Group
SUBSCRIPTION_ID=12345678-1234-1234-1234-123456789012
RESOURCE_GROUP_NAME=rg-certlc-prod
LOCATION=eastus

# Required: Key Vault Configuration
KEY_VAULT_NAME=kv-certlc-prod-001
KEY_VAULT_SKU=standard

# Required: Storage Account Configuration  
STORAGE_ACCOUNT_NAME=stcertlcprod001
STORAGE_ACCOUNT_SKU=Standard_LRS
STORAGE_QUEUE_NAME=cert-renewal-queue

# Required: Automation Account
AUTOMATION_ACCOUNT_NAME=aa-certlc-prod
AUTOMATION_RUNBOOK_NAME=CertificateRenewal
AUTOMATION_SCHEDULE_NAME=DailyCertCheck

# Required: Log Analytics Workspace
LOG_ANALYTICS_WORKSPACE_NAME=law-certlc-prod
LOG_ANALYTICS_SKU=PerGB2018

# Required: Event Grid Configuration
EVENT_GRID_TOPIC_NAME=certlc-events
EVENT_GRID_SUBSCRIPTION_NAME=cert-expiry-subscription

# Certificate Configuration
CERTIFICATE_NAME=example-com-cert
CERTIFICATE_COMMON_NAME=example.com
CERTIFICATE_SAN_LIST=example.com,www.example.com,api.example.com
CERTIFICATE_VALIDITY_DAYS=365
CERTIFICATE_RENEWAL_DAYS_BEFORE=30

# Key Vault Extension Configuration
POLLING_INTERVAL=43200  # 12 hours in seconds
CERTIFICATE_STORE_LOCATION=/var/lib/waagent/Microsoft.Azure.KeyVault/certs

# Optional: Network Configuration
VIRTUAL_NETWORK_NAME=vnet-certlc
SUBNET_NAME=snet-certlc
NSG_NAME=nsg-certlc

# Optional: Tags
TAG_ENVIRONMENT=production
TAG_PROJECT=certificate-lifecycle
TAG_OWNER=infrastructure-team
TAG_COST_CENTER=IT-001

# Optional: Notification Configuration
NOTIFICATION_EMAIL=admin@example.com
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Optional: Security Configuration
ENABLE_SOFT_DELETE=true
ENABLE_PURGE_PROTECTION=true
KEY_VAULT_FIREWALL_ENABLED=false
ALLOWED_IP_ADDRESSES=

# Optional: Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_ACCOUNT=stcertlcbackup001

# Development/Testing Overrides (uncomment for dev environment)
# RESOURCE_GROUP_NAME=rg-certlc-dev
# KEY_VAULT_NAME=kv-certlc-dev-001
# STORAGE_ACCOUNT_NAME=stcertlcdev001
# TAG_ENVIRONMENT=development